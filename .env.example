# Draw a Way: server-side environment variables. Copy to .env.local (never commit it).
# All values below are placeholders. Nothing here is required: with no variables
# set, the app runs in the provider-free "manual" mode and sends nothing anywhere.

# manual (default) | fake (deterministic test double, no network) | groq
INTERPRETER_MODE=manual

# Only read when INTERPRETER_MODE=groq. Server-side only; never use a NEXT_PUBLIC_ prefix.
GROQ_API_KEY=replace-with-your-key

# Optional. Must be in the allowlist in src/lib/interpret/config.ts.
GROQ_MODEL=qwen/qwen3.8-27b

# Optional budget knobs (per server instance, not global). Defaults: 8 and 300.
# Hard ceilings: 60 and 2000.
INTERPRET_PER_MINUTE=8
INTERPRET_PER_DAY=300
